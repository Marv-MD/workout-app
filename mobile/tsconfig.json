{
  "compilerOptions": {
    "allowJs": false,
    "jsx": "react-native",
    "lib": ["esnext"],
    "moduleResolution": "node",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "types": ["react", "react-native"]
  },
  "include": ["./src", "App.tsx"],
  "exclude": ["node_modules"]
}
